# Next.js build-time CLI telemetry. Off by default here so a build of this
# privacy-first app reports nothing anywhere.
NEXT_TELEMETRY_DISABLED=1

# WealthWise environment variables.
# Local-first app: nothing here is required to run the app with manual/CSV entry.
# These are only consulted by the optional server routes described in docs/ARCHITECTURE.md
# (connector webhook receiver, AA/Plaid OAuth handshake, optional LLM prose pass).

# --- Account Aggregator (Setu / Finvu / Onemoney) ---
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_BASE_URL=

# --- Plaid (non-India) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Email ingest (Gmail connector / IMAP) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# --- Optional LLM prose pass (never computes numbers, only rewrites insights) ---
ANTHROPIC_API_KEY=

# --- Web Push (for insight notifications) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
